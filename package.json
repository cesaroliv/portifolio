{
  "name": "criando-com-ia",
  "version": "1.0.0",
  "private": true,
  "description": "Site estático da Criando com IA",
  "scripts": {
    "build": "node scripts/build.js",
    "package": "npm run build && node scripts/package.js",
    "test": "node --test tests/focused.test.js",
    "test:legacy": "node --test tests/site.test.js",
    "design:install": "npx --yes impeccable@4.8.0 install --providers=codex,hermes --scope=project -y",
    "design:detect": "npx --yes impeccable@4.8.0 detect atelier",
    "test:atelier": "node scripts/qa-atelier.cjs",
    "test:atelier:live": "node scripts/qa-atelier-live.cjs",
    "validate": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
